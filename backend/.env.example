# Copy to backend/.env for local development. On the hosting platform,
# set these as environment variables instead of committing a .env file.

# "development" locally, "production" when deployed (enables strict checks)
ENVIRONMENT=development

# Required in production: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Frontend origins allowed to call the API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Leave unset locally to use backend/sql_app.db (SQLite).
# In production use Postgres, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Tried in order when the main model is rate-limited
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Only set to false on a dev machine with broken SSL certificates; ignored in production
GROQ_SSL_VERIFY=true

# Limits
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_LLM_PER_MIN=30

LOG_LEVEL=INFO
